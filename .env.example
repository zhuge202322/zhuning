DATABASE_URL="file:./dev.db"
ADMIN_JWT_SECRET="replace-with-a-long-random-secret"
ANALYTICS_IP_SECRET="replace-with-a-long-random-secret"

# Optional: override the seeded admin login in production.
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="replace-with-a-strong-password"

# Public origin used by canonical URLs, robots.txt, sitemap.xml and social cards.
SITE_URL="https://www.example.com"

# Optional AI SEO bootstrap values. Prefer entering the API key in the protected
# admin page; it is then encrypted in SQLite with ADMIN_JWT_SECRET.
AI_API_ENDPOINT="https://zjapi.com/v1/chat/completions"
AI_MODEL="gpt-5.6-sol"
AI_API_KEY=""

# Optional SMTP settings for future email flows.
SMTP_HOST=""
SMTP_PORT="465"
SMTP_USER=""
SMTP_PASS=""
ADMIN_EMAIL=""
